# Vector database and retrieval
MILVUS_URI=http://localhost:19530
COLLECTION_NAME=papers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FETCH_K=20
TOP_K=5
RRF_K=60
ENABLE_CACHE=true
CACHE_MAX_SIZE=1000
ENABLE_EVIDENCE_DIVERSITY=true
EVIDENCE_DIVERSITY_WEIGHT=0.25

# TRACE explainability and evidence governance
EXPLANATION_GUARD_ENABLED=true
AUTO_EVIDENCE_REPAIR=true
AUTO_EVIDENCE_REPAIR_MAX_QUERIES=2
ENABLE_SEMANTIC_AUDIT=true

# OpenAI-compatible LLM. For local Docker + Ollama, use host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
MAX_RETRIES=2

# Optional vision model
VLM_ENABLED=false
VLM_BASE_URL=http://host.docker.internal:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=ollama

# Optional RAGAS judge overrides (defaults to the main LLM when omitted)
RAGAS_LLM_BASE_URL=http://host.docker.internal:11434/v1
RAGAS_LLM_MODEL=qwen3:8b
RAGAS_LLM_API_KEY=ollama

# Metadata persistence. Docker Compose overrides the host to `postgres`.
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/ruletrace_scholar
METADATA_BACKEND=auto

# Academic discovery. Both values are optional.
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
DISCOVERY_MAX_RESULTS=20
DISCOVERY_TIMEOUT_SECONDS=30
DISCOVERY_DOWNLOAD_TIMEOUT_SECONDS=180

# Files and server
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
HOST=0.0.0.0
PORT=8000
